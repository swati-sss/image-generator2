import SwiftUI
import UIKit

@available(iOS 15.0, *)
public extension Font {
    /// Gets the host-provided Bogle font, or a system font when no font is supplied.
    /// - Parameter size: size of font
    /// - Returns: "Bogle" font (or sytem font as fallback)
    static func bogle(size: CGFloat) -> Font {
        Font(UIFont.bogle(size: size))
    }

    static func bogleMono(size: CGFloat) -> Font {
        Font(UIFont.bogleMono(size: size))
    }
}
