import SwiftUI
import UIKit

@available(iOS 15.0, *)
public extension Image {
    /// Legacy name retained for source compatibility. Uses the explicitly
    /// installed provider; it does not discover or require a resource bundle.
    static func fromBundle(_ name: String) -> Image {
        Image(uiImage: DiamondImage.image(named: name) ?? UIImage())
    }
}
